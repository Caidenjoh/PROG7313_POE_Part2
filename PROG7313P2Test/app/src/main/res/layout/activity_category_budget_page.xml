<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/background_prog"
    android:paddingTop="40dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <!-- Heading -->
    <TextView
        android:id="@+id/budgetHeadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Budget for: Category Name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp" />


    <!-- Minimum Goal Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minimum Monthly Goal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/minGoalInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="numberDecimal"
                android:hint="Enter ideal monthly spending amount" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Maximum Goal Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maximum Monthly Goal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/maxGoalInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="numberDecimal"
                android:hint="Enter your ideal max budget limit" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Save Button -->
    <Button
        android:id="@+id/saveBudgetButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Budget"
        android:textColor="@android:color/white"
        android:backgroundTint="#5F39D3"
        android:layout_marginTop="24dp" />

    <!-- Total Spent Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_vertical">


            <!-- Total Spent Text -->
            <TextView
                android:id="@+id/spendingSummaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total spent this month: R0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <!-- Status Text -->
            <TextView
                android:id="@+id/spendingStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Within Budget"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="0dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Return to Category Page Button -->
    <Button
        android:id="@+id/returnToCategoryPageButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/black"
        android:text="Return to Category Page"
        android:textColor="@android:color/white"
        />

</LinearLayout>
